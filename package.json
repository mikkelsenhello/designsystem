{
  "name": "designsystem",
  "version": "0.5.0",
  "private": true,
  "description": "Rebrandable, token-driven design system (Tailwind v4 + CSS variables).",
  "license": "UNLICENSED",
  "repository": "github:mikkelsenhello/designsystem",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens/*.css": {
      "style": "./tokens/*.css",
      "default": "./tokens/*.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tokens",
    "scripts/check-ds.js",
    "docs",
    "NOTICE.md",
    "README.md"
  ],
  "bin": {
    "check-ds": "./scripts/check-ds.js"
  },
  "scripts": {
    "check:tokens": "node scripts/check-tokens.js",
    "check:ds": "node scripts/check-ds.js src playground --allow-raw-elements src/components",
    "check": "npm run check:tokens && npm run check:ds && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "playground": "next dev playground",
    "playground:brand": "next dev playground",
    "playground:build": "next build playground"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1"
  }
}
